# Local demo (no model key) or live model calls.
COURT_MODE=demo
COURT_DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Alternative: absolute path to a local file containing one API key.
DEEPSEEK_API_KEY_FILE=

DATABASE_PATH=./data/marketing_court.sqlite3
STORAGE_DIR=./data/uploads
# First OCR run downloads model files here; keep them outside version control.
PADDLE_PDX_CACHE_HOME=./data/paddle-cache

# Existing consumer simulator stays available at /jury, demo by default.
JURY_MODE=demo
JURY_DEEPSEEK_MODEL=deepseek-flash
# MARKETING_COURT_MODE and MARKETING_COURT_DEEPSEEK_MODEL, if set, override both modules.
# JURY_DB_PATH=./data/consumer-jury.sqlite3
# JURY_THEORY_SKILL_FILE=/absolute/path/to/SKILL.md
